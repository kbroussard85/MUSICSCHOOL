datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Hub {
  id              String           @id @default(uuid())
  name            String
  city            String
  address         String
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  cohorts         BandCohort[]
  staff           Staff[]          // Legacy direct relation
  staffAssignments StaffAssignment[] // Winston multi-tenant assignments
  students        Student[]
  spaceRentals    SpaceRentalLog[]
  venueLeases     VenueLease[]
  waitlists       Waitlist[]
  crmLeads        CRMLead[]

  @@map("hubs")
}

model Student {
  id                 String          @id @default(uuid())
  userId             String          @unique @map("user_id") // Auth0 sub identifier
  firstName          String          @default("") @map("first_name")
  lastName           String          @default("") @map("last_name")
  name               String          // Plain fallback full name
  emailEncrypted     String          @map("email_encrypted") // Encrypted application-side via AES-256-GCM
  emailHash          String          @unique @map("email_hash") // Deterministic blind index for fast DB indexing/lookups
  parentEmailEnc     String?         @map("parent_email_enc") // Encrypted parent email string
  hubId              String          @map("hub_id")
  hub                Hub             @relation(fields: [hubId], references: [id])
  cohortId           String?         @map("cohort_id")
  cohort             BandCohort?     @relation(fields: [cohortId], references: [id])
  stripeCustomerId   String?         @unique @map("stripe_customer_id")
  subscriptionStatus String?         @map("subscription_status")
  commitmentEndDate  DateTime?       @map("commitment_end_date") // 90-day minimum lock
  age                Int?            @default(12)
  instrument         String?         @default("Keyboard")
  phone              String?         @default("")
  practiceLogs       PracticeLog[]
  privateLessons     PrivateLesson[]
  paymentLogs        PaymentLog[]
  attendances        Attendance[]
  bandAssignments    BandMember[]
  masterClasses      MasterClassAttendee[]
  createdAt          DateTime        @default(now()) @map("created_at")

  @@map("students")
}

model Staff {
  id              String          @id @default(uuid())
  userId          String          @unique @map("user_id") // Auth0 sub identifier
  email           String          @unique
  name            String
  firstName       String          @default("") @map("first_name")
  lastName        String          @default("") @map("last_name")
  role            String          // "DIRECTOR", "INSTRUCTOR", "ADMIN"
  hourlyRate      Float           @map("hourly_rate") // $30 for directors, $26 for instructors
  isActive        Boolean         @default(true) @map("is_active")
  hubId           String          @map("hub_id")
  hub             Hub             @relation(fields: [hubId], references: [id])
  directedCohorts BandCohort[]    @relation("DirectorRelation")
  givenLessons    PrivateLesson[]
  assignments     StaffAssignment[]
  masterClasses   MasterClassInstructor[]
  createdAt       DateTime        @default(now()) @map("created_at")

  @@map("staff")
}

model BandCohort {
  id            String        @id @default(uuid())
  name          String
  ageGroup      String        @map("age_group") // "9-12", "13-17", "18+"
  scheduleDay   String        @map("schedule_day") // "Tuesday", "Wednesday"
  scheduleSlot  String        @map("schedule_slot") // "4:00 PM - 5:30 PM", "5:30 PM - 7:00 PM", "7:00 PM - 8:30 PM"
  hubId         String        @map("hub_id")
  hub           Hub           @relation(fields: [hubId], references: [id])
  directorId    String?       @map("director_id")
  director      Staff?        @relation("DirectorRelation", fields: [directorId], references: [id])
  students      Student[]
  attendances   Attendance[]
  members       BandMember[]
  showcaseTheme String?       @map("showcase_theme")
  showcaseVenue String?       @map("showcase_venue")
  showcaseDate  DateTime?     @map("showcase_date")
  setlistSongs  SetlistSong[]
  createdAt     DateTime      @default(now()) @map("created_at")

  @@map("band_cohorts")
}

model SpaceRentalLog {
  id          String   @id @default(uuid())
  hubId       String   @map("hub_id")
  hub         Hub      @relation(fields: [hubId], references: [id])
  date        DateTime
  hoursLogged Float    @map("hours_logged") // 9 hours/week total
  cost        Float    @map("cost") // $40/hour
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("space_rental_logs")
}

model VenueLease {
  id        String   @id @default(uuid())
  hubId     String   @map("hub_id")
  hub       Hub      @relation(fields: [hubId], references: [id])
  name      String   @map("venue_name")
  leaseDate DateTime @map("lease_date")
  cost      Float    // Sinking fund rent tracking ($1,000–$1,500)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("venue_leases")
}

model PrivateLesson {
  id              String   @id @default(uuid())
  studentId       String   @map("student_id")
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instructorId    String   @map("instructor_id")
  instructor      Staff    @relation(fields: [instructorId], references: [id])
  scheduledAt     DateTime @map("scheduled_at")
  durationMinutes Int      @default(45) @map("duration_minutes") // standard 45-min
  type            String   // "ONLINE_STANDARD" or "IN_PERSON_UPSELL"
  roomCost        Float?   @map("room_cost") // For Monday-Thursday private lesson upsells ($150/mo)
  status          String   // "SCHEDULED", "COMPLETED", "CANCELED"
  isCompleted     Boolean  @default(false) @map("is_completed")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("private_lessons")
}

model PaymentLog {
  id              String   @id @default(uuid())
  studentId       String   @map("student_id")
  student         Student  @relation(fields: [studentId], references: [id])
  stripeInvoiceId String?  @map("stripe_invoice_id")
  amountPaid      Float    @map("amount_paid")
  status          String   // "PAID", "FAILED", "CHARGED_BACK"
  billingDate     DateTime @map("billing_date")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("payment_logs")
}

model Attendance {
  id            String     @id @default(uuid())
  studentId     String     @map("student_id")
  student       Student    @relation(fields: [studentId], references: [id])
  cohortId      String     @map("cohort_id")
  cohort        BandCohort @relation(fields: [cohortId], references: [id])
  rehearsalDate DateTime   @map("rehearsal_date")
  present       Boolean    @default(true)
  createdAt     DateTime   @default(now()) @map("created_at")

  @@map("attendances")
}

model PracticeLog {
  id         String   @id @default(uuid())
  studentId  String   @map("student_id")
  student    Student  @relation(fields: [studentId], references: [id])
  duration   Float    // duration in hours
  notes      String   // piece/notes practiced
  dateLogged DateTime @default(now()) @map("date_logged")

  @@map("practice_logs")
}

model Waitlist {
  id           String   @id @default(uuid())
  hubId        String   @map("hub_id")
  hub          Hub      @relation(fields: [hubId], references: [id])
  studentName  String   @map("student_name")
  studentEmail String   @map("student_email")
  age          Int
  instrument   String
  priority     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("waitlists")
}

model StaffAssignment {
  id        String   @id @default(uuid())
  staffId   String   @map("staff_id")
  hubId     String   @map("hub_id")
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  hub       Hub      @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@unique([staffId, hubId])
  @@map("staff_assignments")
}

model BandMember {
  id        String     @id @default(uuid())
  studentId String     @map("student_id")
  cohortId  String     @map("cohort_id")
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cohort    BandCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([studentId, cohortId])
  @@map("band_members")
}

model CRMLead {
  id                  String             @id @default(uuid())
  hubId               String             @map("hub_id")
  status              LeadStatus         @default(INQUIRY_RECEIVED)
  parentNameEncrypted String?            @map("parent_name_encrypted")
  studentName         String             @map("student_name")
  phoneEncrypted      String             @map("phone_encrypted")
  phoneHash           String             @unique @map("phone_hash") // Blind index hash for secure phone searches
  notesEncrypted      String?            @map("notes_encrypted") @db.Text
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  hub                 Hub                @relation(fields: [hubId], references: [id])
  communications      CommunicationLog[]

  @@map("crm_leads")
}

model CommunicationLog {
  id               String            @id @default(uuid())
  leadId           String            @map("lead_id")
  type             CommunicationType
  agentStaffId     String            @map("agent_staff_id")
  summaryEncrypted String            @map("summary_encrypted") @db.Text
  timestamp        DateTime          @default(now())
  lead             CRMLead           @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("communication_logs")
}

model MasterClass {
  id              String                  @id @default(uuid())
  topic           String
  scheduledAt     DateTime                @map("scheduled_at")
  durationMinutes Int                     @default(60) @map("duration_minutes")
  maxSeats        Int                     @default(25) @map("max_seats")
  instructors     MasterClassInstructor[]
  attendees       MasterClassAttendee[]

  @@map("master_classes")
}

model MasterClassInstructor {
  id            String      @id @default(uuid())
  masterClassId String      @map("master_class_id")
  instructorId  String      @map("instructor_id")
  masterClass   MasterClass @relation(fields: [masterClassId], references: [id], onDelete: Cascade)
  instructor    Staff       @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([masterClassId, instructorId])
  @@map("master_class_instructors")
}

model MasterClassAttendee {
  id            String      @id @default(uuid())
  masterClassId String      @map("master_class_id")
  studentId     String      @map("student_id")
  attendedAt    DateTime    @default(now()) @map("attended_at")
  masterClass   MasterClass @relation(fields: [masterClassId], references: [id], onDelete: Cascade)
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([masterClassId, studentId])
  @@map("master_class_attendees")
}

enum CommunicationType {
  EMAIL
  SMS
  PHONE_CALL
}

enum LeadStatus {
  INQUIRY_RECEIVED
  TRIAL_SCHEDULED
  TRIED_NOT_ENROLLED
  CONVERTED_ACTIVE
  WAITLISTED
}

model VaultItem {
  id          String   @id @default(uuid())
  title       String
  artist      String?
  type        String   // "TAB", "VIDEO", "MASTERCLASS"
  category    String   // "guitar", "bass", "synth/keys", "drums", "vocal", "all"
  url         String   // link or file path
  thumbnail   String?  // thumbnail preview image
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("vault_items")
}

model GearItem {
  id          String   @id @default(uuid())
  name        String
  category    String   // "books", "guitar", "bass", "synth/keys", "drums", "audio production"
  price       Float
  image       String   // image URL or asset path
  description String
  stock       Int      @default(10)
  hyperlink   String?  // External affiliate or buy link
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("gear_items")
}

model BulletinNote {
  id         String   @id @default(uuid())
  authorName String   @map("author_name")
  authorRole String   @map("author_role") // "STUDENT", "INSTRUCTOR", "DIRECTOR", "ADMIN"
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("bulletin_notes")
}

model SetlistSong {
  id        String     @id @default(uuid())
  cohortId  String     @map("cohort_id")
  cohort    BandCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  title     String
  artist    String
  progress  Int        @default(0) // progress percentage e.g. 80 for 80%
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("setlist_songs")
}
