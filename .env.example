# =========================================================================
# HARMONY MUSIC ACADEMY - CORE MONOREPO ENVIRONMENT TEMPLATE
# =========================================================================

# --- 1. DATABASE CONFIGURATION (PostgreSQL / Prisma)
# Connection string to pooled PostgreSQL database (e.g. Supabase, AWS RDS)
DATABASE_URL="postgresql://postgres:password@localhost:5432/harmony_db?schema=public"
# Direct connection string bypassing connection poolers (required for Prisma migrations)
DIRECT_URL="postgresql://postgres:password@localhost:5432/harmony_db?schema=public"

# --- 2. IDENTITY & ACCESS MANAGEMENT (Auth0 Config)
# The domain of your Auth0 tenant
AUTH0_DOMAIN="harmony-academy.us.auth0.com"
# Client ID for your Next.js application
AUTH0_CLIENT_ID="your_auth0_client_id"
# Client Secret for your Next.js application
AUTH0_CLIENT_SECRET="your_auth0_client_secret"
# Random 32-character string used to encrypt session cookies
AUTH0_SECRET="some_very_long_random_secret_string_32_characters_long"
# Base URL of the web app (no trailing slash)
AUTH0_BASE_URL="http://localhost:3000"

# --- 3. ULTRA-LOW-LATENCY WEBRTC JAM ENGINE
# URL of the signaling room server (SFU)
NEXT_PUBLIC_SFU_SERVER_URL="http://localhost:4000"

# --- 4. BILLING & SUBSCRIPTIONS (Stripe)
# Stripe API Secret key
STRIPE_SECRET_KEY="sk_test_..."
# Stripe Webhook verification secret (used in api/stripe-webhooks)
STRIPE_WEBHOOK_SECRET="whsec_..."
