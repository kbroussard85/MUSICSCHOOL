{
  "name": "my-hybrid-music-school",
  "version": "1.0.0",
  "description": "Monorepo Workspace for Harmony Music School Platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build:deps": "npm run build --workspace=@harmony/ui",
    "build:web": "npm run build --workspace=web",
    "build": "npm run build:deps && npm run build:web",
    "start": "npm run start --workspace=web"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^6.19.3"
  }
}
